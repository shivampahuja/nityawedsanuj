der-val=\"{{ false }}\">\n          <div style=\"display:flex;flex-direction:column;gap:20px\">\n            <div style=\"display:flex;flex-direction:column;gap:10px\">\n              <span style=\"font-family:'Jost',sans-serif;font-weight:500;font-size:12px;letter-spacing:.2em;color:#e3c79a\">NUMBER OF GUESTS</span>\n              <div style=\"display:flex;align-items:center;gap:18px\">\n                <button sc-camel-on-click=\"{{ dec }}\" style=\"width:48px;height:48px;border-radius:50%;border:1px solid #f0c98a;background:none;color:#f0c98a;font-size:22px;cursor:pointer\">−</button>\n                <div style=\"font-family:'Jost',sans-serif;font-weight:500;font-size:28px;min-width:30px;text-align:center\">{{ guests }}</div>\n                <button sc-camel-on-click=\"{{ inc }}\" style=\"width:48px;height:48px;border-radius:50%;border:1px solid #f0c98a;background:none;color:#f0c98a;font-size:22px;cursor:pointer\">+</button>\n              </div>\n            </div>\n            <div style=\"display:flex;flex-direction:column;gap:10px\">\n              <span style=\"font-family:'Jost',sans-serif;font-weight:500;font-size:12px;letter-spacing:.2em;color:#e3c79a\">EVENTS ATTENDING</span>\n              <div style=\"display:flex;flex-wrap:wrap;gap:8px\">\n                <sc-for list=\"{{ events }}\" as=\"e\" hint-placeholder-count=\"3\">\n                  <button sc-camel-on-click=\"{{ e.toggle }}\" style=\"min-height:44px;padding:0 18px;border-radius:22px;border:1px solid #f0c98a;background:{{ e.bg }};color:{{ e.fg }};font-size:18px;cursor:pointer\">{{ e.label }}</button>\n                </sc-for>\n              </div>\n            </div>\n          </div>\n        </sc-if>\n        <label style=\"display:flex;flex-direction:column;gap:8px\">\n          <span style=\"font-family:'Jost',sans-serif;font-weight:500;font-size:12px;letter-spacing:.2em;color:#e3c79a\">A NOTE FOR THE COUPLE</span>\n          <textarea value=\"{{ note }}\" sc-camel-on-change=\"{{ setNo